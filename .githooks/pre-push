#!/bin/sh
# Refuse pushes to main: it changes only through a merged pull request. Then, when the real
# settings file or the privacy denylist is present, refuse the push if any commit, commit
# message, file name or ref name holds one of their values.
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
status=0
while read -r _ _ remote_ref _; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/master)
            echo "pre-push: pushing to '${remote_ref#refs/heads/}' is refused. Push a feature branch and open a pull request." >&2
            status=1
            ;;
    esac
done
[ "$status" -eq 0 ] || exit "$status"

top=$(git rev-parse --show-toplevel)
denylist="$(git rev-parse --absolute-git-dir)/info/privacy-denylist"
if [ -f "$top/Launcher/settings.psd1" ] || [ -f "$denylist" ]; then
    if ! powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File "$top/tools/Find-PrivateData.ps1" -History; then
        echo "pre-push: refused. Remove the values tools/Find-PrivateData.ps1 reported, then push again." >&2
        exit 1
    fi
fi
exit 0

#!/bin/sh
# Refuse commits on main, then run privacy-scan on the staged files. Every change goes on a
# feature branch and reaches main through a reviewed pull request. A detached HEAD, as during
# a rebase, is not refused, but its staged files are still scanned.
branch=$(git symbolic-ref --quiet --short HEAD) || branch=
case "$branch" in
    main | master)
        echo "pre-commit: commits on '$branch' are refused. Create a feature branch first, for example:" >&2
        echo "    git switch -c fix/short-name" >&2
        exit 1
        ;;
esac
exec sh "$(git rev-parse --show-toplevel)/.githooks/privacy-scan" --staged
